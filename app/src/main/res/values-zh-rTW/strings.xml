    <string name="dialog_oppo_title">⚠️ OPPO/Realme 用戶請注意</string>
    <string name="dialog_oppo_msg">請至電池設定中，允許此 App 的「背景執行」與「自啟動」，並關閉「智慧 5G」。</string>
    
    <string name="dialog_vivo_title">⚠️ Vivo 用戶請注意</string>
